{
  "name": "congress-contributions",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-first proof of concept for tracking legislative contributions",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "start:server": "node server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/congress/*.test.mjs scripts/db/*.test.mjs scripts/server/*.test.mjs",
    "ingest:congress": "node scripts/ingest-congress.mjs",
    "data:export-curated-api": "node scripts/export-curated-api.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:inspect": "node scripts/db/inspect.mjs",
    "db:reset": "node scripts/db/reset.mjs"
  },
  "keywords": [
    "congress",
    "legislation",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "pg-mem": "^3.0.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
